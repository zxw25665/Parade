# =================================================================
# “游行 (Parade)” 官方 Git 忽略模板
# =================================================================

# --- 编译产物 (Build Artifacts) ---
bin/
obj/
dist/
# Wails 默认编译输出目录
build/bin/
build/windows/
build/darwin/
build/linux/
# 前端编译产物
frontend/dist/
# 所有的可执行文件
*.exe
*.exe~
*.dll
*.so
*.dylib
# Wails 临时运行文件
wails-temp/

# --- SQLite 数据库与缓存 (Database & WAL) ---
# 忽略所有生成的数据库物理文件
*.db
*.sqlite
*.sqlite3
# ！！！极其重要：忽略 SQLite 的预写日志和共享内存文件
# 这些文件在程序运行时产生，包含未写入磁盘的数据碎片
*-wal
*-shm
*-journal

# --- 用户身份与加解密安全 (Security & Identity) ---
# 用户的私钥凭证文件（绝对不能上传到 Git，否则泄露身份）
*.parade_identity
.env
*.pem
*.key

# --- Go 依赖与环境 (Go / Backend) ---
vendor/
go.work
.GOPATH
.cache/

# --- 前端依赖、日志与生成代码 (Frontend / Node / Generated) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache
.stylelintcache
# Wails 自动生成的前端绑定代码（每次 wails build/dev 重新生成）
frontend/src/lib/wailsjs/
# 前端包校验和文件（自动生成）
frontend/package.json.md5

# --- 编辑器与系统文件 (IDE & OS) ---
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.bak
.DS_Store
Thumbs.db
desktop.ini

# --- 测试产物 ---
# 忽略我们之前测试生成的临时数据库
test_*.db
test_*-wal
test_*-shm
.parade.log
logsfordebug/

# CLAUDE.md is AI assistant context, not project documentation
CLAUDE.md
AGENTS.md
network-debug-instruction.md

.parade_*
.opencode
parade
