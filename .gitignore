# =================================================================
# 1. Wails & Go 编译产物
# =================================================================
# Wails 默认的二进制输出目录
/build/bin/

# 如果你手动执行 go build 生成的二进制文件
*.exe
*.exe~
*.dll
*.so
*.dylib
/build/darwin/*.app

# Wails 运行时的临时文件或日志
wails.log
wails.json.bak

# =================================================================
# 2. Go 后端相关
# =================================================================
# 依赖包 (如果你不使用 vendor 模式，通常忽略)
# vendor/

# Go 单元测试生成的缓存或覆盖率报告
*.test
*.out
coverage.txt

# =================================================================
# 3. 前端相关 (Vue / Node.js)
# =================================================================
# 忽略前端依赖
**/node_modules/

# 忽略 Vue 编译后的产物 (Wails 会在打包时重新生成)
# 注意：路径需根据你的实际目录调整，通常是 frontend/dist
frontend/dist/
frontend/dist-ssr/
frontend/*.que

# npm/yarn/pnpm 日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 前端环境配置文件
frontend/.env.local
frontend/.env.*.local

# =================================================================
# 4. 操作系统 & 编辑器相关
# =================================================================
# macOS
.DS_Store

# Windows
Thumbs.db
desktop.ini

# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json

# JetBrains (GoLand, WebStorm)
.idea/

# =================================================================
# 5. 其他环境 & 敏感信息
# =================================================================
.env
.env.local
*.log
tmp/
